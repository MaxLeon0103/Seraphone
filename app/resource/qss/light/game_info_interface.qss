GameInfoInterface {
    border: none;
    background-color: transparent;
}

SummonersView {
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background-color: rgba(255, 255, 255, 0.72);
}

#summonersGamesView {
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background-color: rgba(255, 255, 255, 0.72);
}

SummonerInfoView {
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.08);
}

SummonerName {
    font: bold 13px 'Microsoft YaHei', 'Segoe UI';
    padding: 4px 6px 4px 6px;
    color: black;
    border: none;
    background-color: transparent;
}

SummonerName:hover {
    color: --ThemeColorLight1;
}

SummonerName[pressed=true] {
    color: --ThemeColorLight3;
}

SummonerName:disabled {
    color: rgba(0, 0, 0, 0.43)
}

SummonerInfoView>QLabel {
    font: 12px 'Segoe UI', 'Microsoft YaHei';
}

SummonerInfoView>SummonerName {
    font: bold 13px 'Microsoft YaHei', 'Segoe UI';
    padding: 4px 6px 4px 6px;
    color: black;
    border: none;
    background-color: transparent;
}

SummonerInfoView>#kdaLabel,
SummonerInfoView>#kdaValLabel {
    font: 11px 'Segoe UI', 'Microsoft YaHei';
}

SummonerInfoView>#kdaValLabel {
    font: bold;
}

GameTab {
    border-radius: 12px;
    border: 1px solid;
}

GameTab>QLabel {
    font: 13px 'Segoe UI', 'Microsoft YaHei';
}

GameTab>#time {
    font: 11px;
}

GameTab>#kills,
GameTab>#slash1,
GameTab>#deaths,
GameTab>#slash2,
GameTab>#assists {
    font: bold 11px;
}

Games {
    border: none;
    border-right: 1px solid rgba(0, 0, 0, 0.08);
    background-color: transparent;
}

Games[isLast=true] {
    border: none;
}

Games>#summonerName {
    font: bold 15px 'Microsoft YaHei', 'Segoe UI';
}

Games:hover {
    background-color: rgba(233, 233, 233, 0.42);
}

Games[isFirst=true]:hover {
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
    background-color: rgba(233, 233, 233, 0.42);
}

Games[isLast=true]:hover {
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(233, 233, 233, 0.42);
}
