SettingInterface,
#scrollWidget {
    background-color: transparent;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QLabel#settingLabel {
    font: 700 34px 'Segoe UI', 'PingFang SC', 'Microsoft YaHei';
    letter-spacing: 0.5px;
    background-color: transparent;
}

ColorAnimationFrame {
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
}

ModeCheckButtonsGroup>#separator {
    color: rgba(0, 0, 0, 0.08);
}
